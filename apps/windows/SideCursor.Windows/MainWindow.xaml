<Window x:Class="SideCursor.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SideCursor for Windows"
        Width="800"
        Height="650"
        MinWidth="720"
        MinHeight="560"
        Closing="OnClosing">
  <Grid Margin="18">
    <TabControl>
      <TabItem Header="Status">
        <StackPanel Margin="16">
          <TextBlock Text="SideCursor Windows companion" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="Receives Mac input only after an authenticated entry acknowledgement." Margin="0,6,0,18" Foreground="DimGray" />
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Session" FontWeight="SemiBold" />
            <TextBlock x:Name="SessionStateText" Grid.Row="0" Grid.Column="1" Text="Disconnected" />
            <TextBlock Grid.Row="1" Text="Transport" FontWeight="SemiBold" />
            <TextBlock x:Name="TransportStateText" Grid.Row="1" Grid.Column="1" />
            <TextBlock Grid.Row="2" Text="Round-trip time" FontWeight="SemiBold" />
            <TextBlock x:Name="LatencyText" Grid.Row="2" Grid.Column="1" Text="Waiting for peer" />
            <TextBlock Grid.Row="3" Text="Target display" FontWeight="SemiBold" />
            <TextBlock x:Name="TargetDisplayStateText" Grid.Row="3" Grid.Column="1" Text="Not selected" TextWrapping="Wrap" />
            <TextBlock Grid.Row="4" Text="Elevation" FontWeight="SemiBold" />
            <TextBlock x:Name="ElevationText" Grid.Row="4" Grid.Column="1" TextWrapping="Wrap" />
          </Grid>
          <StackPanel Orientation="Horizontal">
            <Button Content="Connect / Reconnect" Click="OnReconnectClick" />
            <Button Content="Return control to Mac" Click="OnReturnClick" />
            <Button Content="Open diagnostics" Click="OnDiagnosticsClick" />
          </StackPanel>
          <Border Margin="0,20,0,0" Padding="12" BorderBrush="#FFD9A441" BorderThickness="1" Background="#FFFFF9E8">
            <TextBlock TextWrapping="Wrap">
              SideCursor intentionally does not capture your local Windows keyboard or mouse. It only injects authenticated Mac input while the session is Remote. If Windows cannot inject into an elevated app, run SideCursor elevated too.
            </TextBlock>
          </Border>
        </StackPanel>
      </TabItem>

      <TabItem Header="Pairing &amp; transport">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">
            <TextBlock Text="Connection" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Tailscale TCP is the default. Bluetooth starts a local, encrypted RFCOMM listener only when selected; it never switches automatically." TextWrapping="Wrap" Foreground="DimGray" Margin="0,6,0,14" />
            <TextBlock Text="Transport" />
            <ComboBox x:Name="TransportCombo" SelectionChanged="OnTransportChanged" Margin="0,3,0,8">
              <ComboBoxItem Tag="TailscaleTcp" Content="Tailscale TCP (recommended)" />
              <ComboBoxItem Tag="BluetoothRfcomm" Content="Bluetooth RFCOMM (manual fallback)" />
            </ComboBox>
            <StackPanel x:Name="TcpSettingsPanel">
              <TextBlock Text="Mac Tailscale address or hostname" />
              <TextBox x:Name="PeerHostText" />
              <TextBlock Text="Mac listener port" />
              <TextBox x:Name="PeerPortText" />
            </StackPanel>
            <StackPanel x:Name="BluetoothSettingsPanel" Visibility="Collapsed">
              <TextBlock Text="Advertised SideCursor service UUID" />
              <TextBlock x:Name="BluetoothServiceText" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,3,0,8" />
              <TextBlock Text="Pair both computers in Windows/macOS first. Save and reconnect; this app then advertises the service and waits. The Mac resolves the current RFCOMM channel through Bluetooth SDP, so no old Python channel number is entered." TextWrapping="Wrap" Foreground="DimGray" />
            </StackPanel>
            <Separator Margin="0,16,0,12" />
            <TextBlock Text="Pairing code" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="Paste the one-time 32-byte base64url pairing secret here. It is encrypted with Windows DPAPI and is never logged. Leave blank to preserve the existing pairing." TextWrapping="Wrap" Foreground="DimGray" Margin="0,6,0,8" />
            <PasswordBox x:Name="PairingCodeBox" Margin="0,3,0,8" MinWidth="420" HorizontalAlignment="Left" Width="420" />
            <TextBlock x:Name="PairingStateText" Text="No pairing secret saved" Foreground="DimGray" />
            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
              <Button Content="Save settings" Click="OnSaveSettingsClick" />
              <Button Content="Save and reconnect" Click="OnSaveAndReconnectClick" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Displays &amp; input">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="16">
            <TextBlock Text="Windows target display" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="The selected stable monitor identity receives the Mac handoff. Windows sends a return request only at this display’s left edge." TextWrapping="Wrap" Foreground="DimGray" Margin="0,6,0,8" />
            <ComboBox x:Name="TargetDisplayCombo" DisplayMemberPath="Label" Margin="0,3,0,6" />
            <Button Content="Refresh display list" Click="OnRefreshDisplaysClick" HorizontalAlignment="Left" />
            <TextBlock Text="Pointer speed" FontSize="20" FontWeight="SemiBold" Margin="0,18,0,0" />
            <TextBlock Text="Pointer speed is set on the Mac (SideCursor Settings → pointer scale), which owns the raw trackpad input. Windows maps Mac pointer units to this display’s pixels automatically." TextWrapping="Wrap" Foreground="DimGray" Margin="0,6,0,4" />
            <CheckBox x:Name="AbsolutePointerCheck" Content="Unaccelerated 1:1 pointer movement (recommended)" Margin="0,10,0,0" />
            <TextBlock Text="Absolute movement bypasses Windows pointer acceleration and matches Mac motion exactly. Uncheck to fall back to accelerated relative motion." TextWrapping="Wrap" Foreground="DimGray" Margin="0,2,0,0" />
            <TextBlock Text="Return-edge inset (physical pixels)" Margin="0,14,0,0" />
            <TextBox x:Name="ReturnEdgeInsetText" />
            <Separator Margin="0,14,0,12" />
            <TextBlock Text="Remote command bindings" FontSize="20" FontWeight="SemiBold" />
            <TextBlock Text="These safe Windows chords are invoked by authenticated Mac command messages. Use plus-separated virtual-key names, for example WIN+CTRL+LEFT." TextWrapping="Wrap" Foreground="DimGray" Margin="0,6,0,8" />
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="Desktop left" VerticalAlignment="Center" />
              <TextBox x:Name="DesktopLeftText" Grid.Row="0" Grid.Column="1" />
              <TextBlock Grid.Row="1" Text="Desktop right" VerticalAlignment="Center" />
              <TextBox x:Name="DesktopRightText" Grid.Row="1" Grid.Column="1" />
              <TextBlock Grid.Row="2" Text="Task View" VerticalAlignment="Center" />
              <TextBox x:Name="TaskViewText" Grid.Row="2" Grid.Column="1" />
              <TextBlock Grid.Row="3" Text="Show Desktop" VerticalAlignment="Center" />
              <TextBox x:Name="ShowDesktopText" Grid.Row="3" Grid.Column="1" />
            </Grid>
            <Button Content="Save input settings" Click="OnSaveSettingsClick" HorizontalAlignment="Left" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Clipboard &amp; safety">
        <StackPanel Margin="16">
          <TextBlock Text="Clipboard" FontSize="20" FontWeight="SemiBold" />
          <CheckBox x:Name="ClipboardEnabledCheck" Content="Synchronize plain-text clipboard in both directions" Margin="0,10,0,8" />
          <TextBlock Text="Maximum text size in bytes (1–1,048,576)" />
          <TextBox x:Name="ClipboardMaximumText" />
          <TextBlock Text="Remote clipboard updates are tagged locally to prevent echo loops. Files, images, and rich clipboard formats are intentionally not transferred." TextWrapping="Wrap" Foreground="DimGray" />
          <Separator Margin="0,24,0,14" />
          <TextBlock Text="Safety" FontSize="20" FontWeight="SemiBold" />
          <TextBlock Text="Connection loss, invalid encrypted frames, target-display removal, and Return control release tracked Windows keys and mouse buttons before the session reconnects. A forced process termination cannot release input, so use Return control (or the tray menu) before killing SideCursor." TextWrapping="Wrap" />
          <Button Content="Release all injected input now" Click="OnReleaseInputClick" Margin="0,14,0,0" HorizontalAlignment="Left" />
          <Button Content="Save clipboard settings" Click="OnSaveSettingsClick" HorizontalAlignment="Left" />
        </StackPanel>
      </TabItem>

      <TabItem Header="Diagnostics">
        <Grid Margin="16">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel Orientation="Horizontal">
            <Button Content="Refresh" Click="OnRefreshDiagnosticsClick" />
            <Button Content="Copy diagnostics" Click="OnCopyDiagnosticsClick" />
          </StackPanel>
          <TextBox x:Name="DiagnosticsText" Grid.Row="1" Margin="0,8,0,0" FontFamily="Consolas" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" />
        </Grid>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
